{
  "name": "kame-lends",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev/free-local-ports.sh && vite dev --strictPort",
    "dev:stack": "bash ./dev.sh",
    "dev:ui": "bash ./dev.sh --ui-only",
    "dev:free-ports": "bash scripts/dev/free-local-ports.sh",
    "build": "vite build && node scripts/deploy/copy-pdfkit-standard-fonts.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint": "bun run format:check && bun run lint:js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "ci:quality": "bun run check && bun run format:check && bun run lint:js && bun run test:unit && bun run check:ai-tooling-sync && bun run build && node scripts/pwa/check-precache-budget.mjs && CI=true bun run test:e2e:pwa",
    "pwa:capture-screenshots": "bun scripts/pwa/capture-screenshots.ts",
    "pwa:generate-vapid-keys": "bun scripts/pwa/generate-vapid-keys.ts",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "check:all": "bun run ci:quality",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "backup:neon": "bash scripts/backup/backup-neon.sh",
    "backup:neon:branches": "bash scripts/backup/create-neon-branches.sh",
    "setup:ai-tooling": "bash scripts/dev/setup-ai-tooling.sh",
    "check:ai-tooling-sync": "bash scripts/dev/check-ai-tooling-sync.sh",
    "brand:assets": "bun scripts/brand/generate-brand-assets.ts",
    "build:clean": "rm -rf .svelte-kit .vercel/output && svelte-kit sync && vite build",
    "db:local:start": "docker compose up -d",
    "db:local:stop": "docker compose down",
    "db:local:push": "bash scripts/db/local-db-push.sh",
    "db:local:migrate": "bash scripts/db/local-db-push.sh",
    "db:local:studio": "DATABASE_URL=postgresql://kame_lends:kame_lends@127.0.0.1:5433/kame_lends drizzle-kit studio",
    "db:local:sync-prod": "bash scripts/db/sync-prod-to-local.sh",
    "db:backfill:investor-links": "bash scripts/db/backfill-investor-user-links.sh",
    "db:backfill:witnesses": "bash scripts/db/backfill-witnesses.sh",
    "db:backfill:storage": "bun scripts/db/backfill-storage-to-r2.ts",
    "db:backfill:group-members": "bun scripts/db/backfill-group-members.ts",
    "dev:wipe-workspace-calendar": "bun scripts/dev/wipe-workspace-calendar.ts",
    "dev:backfill-group-calendar-colors": "bun scripts/dev/backfill-group-calendar-colors.ts",
    "telegram:set-webhook": "bun scripts/telegram/set-webhook.ts",
    "db:apply:migration": "bash scripts/db/apply-migration.sh",
    "db:apply:migration:prod": "bash scripts/db/apply-migration.sh --prod",
    "db:apply:migration:vercel": "bash scripts/db/apply-migration.sh --vercel",
    "db:migrate:pending": "bash scripts/db/migrate-pending.sh",
    "db:migrate:pending:prod": "bash scripts/db/migrate-pending.sh --prod",
    "db:migrate:pending:vercel": "bash scripts/db/migrate-pending.sh --vercel",
    "db:migrate:check": "bash scripts/db/check-migrations-pending.sh",
    "db:migrate:check:prod": "bash scripts/db/check-migrations-pending.sh --prod",
    "db:migrate:check:vercel": "bash scripts/db/check-migrations-pending.sh --vercel",
    "deploy:prod": "bash scripts/deploy/vercel-prod.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.42.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "bits-ui": "^2.16.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@auth/sveltekit": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/functions": "^3.9.7",
    "apexcharts": "^7.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^178.0.0",
    "lucide-svelte": "^1.0.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "svelte-sonner": "^1.2.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  }
}
