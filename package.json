{
	"name": "kame-lends",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:all": "bun run check && bun run lint && bun run test:unit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"backup:neon": "bash scripts/backup/backup-neon.sh",
		"backup:neon:branches": "bash scripts/backup/create-neon-branches.sh",
		"setup:ai-tooling": "bash scripts/dev/setup-ai-tooling.sh",
		"check:ai-tooling-sync": "bash scripts/dev/check-ai-tooling-sync.sh",
		"build:clean": "rm -rf .svelte-kit .vercel/output && svelte-kit sync && vite build",
		"db:local:start": "docker compose up -d",
		"db:local:push": "bash scripts/db/local-db-push.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.42.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"bits-ui": "^2.16.3",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"@commitlint/cli": "^19.7.1",
		"@commitlint/config-conventional": "^19.7.1",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@auth/core": "^0.41.3",
		"@auth/drizzle-adapter": "^1.11.3",
		"@auth/sveltekit": "^1.11.3",
		"@neondatabase/serverless": "^1.1.0",
		"@react-pdf/renderer": "^4.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"googleapis": "^178.0.0",
		"layerchart": "^2.4.0",
		"lucide-svelte": "^1.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"resend": "^6.26.0",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4"
	}
}
