# Database. Named URLs for switching; the app reads DATABASE_URL only.
# DATABASE_URL_LOCAL="postgresql://kame_lends:kame_lends@127.0.0.1:5433/kame_lends"
# DATABASE_URL_PROD="postgresql://neondb_owner:...@ep-....ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_VERCEL="postgresql://...@ep-....us-east-1.aws.neon.tech/neondb?sslmode=require"
#   Optional local copy of Vercel Production DATABASE_URL for manual migrate/repair.
#   GitHub Actions CD uses the DATABASE_URL Actions secret (same value as Vercel Production).
# DATABASE_URL="postgresql://..."

# Auth.js
AUTH_SECRET="your-generated-secret-here"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# E2E only (local / preview). Never set on production Vercel.
# E2E_AUTH_SECRET="e2e-local-secret"
# E2E_USER_EMAIL="you@example.com"

# Google Calendar API
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="primary"

# Public (SvelteKit PUBLIC_ prefix)
PUBLIC_APP_URL="https://kame-lends.vercel.app"
PUBLIC_CONTRACT_DISPUTE_VENUE="Pampanga, Philippines"

# AI receipt scanning (optional). Reads uploaded payment receipts to prefill
# amount/date/sender when recording a fund transfer or borrower payment.
# Feature degrades gracefully to manual entry when unset.
# Comma-separate multiple free-tier Gemini keys to rotate across quota limits.
GEMINI_API_KEYS="key1,key2"
# Or a single key:
# GEMINI_API_KEY="your-gemini-api-key"
# Optional fallback used only if all Gemini keys are rate-limited/unavailable:
GROQ_API_KEY="your-groq-api-key"

# Backup (optional)
RESEND_API_KEY="re_xxxxxxxxxx"
BACKUP_EMAIL="your-email@example.com"
RESEND_FROM_EMAIL="Kame Lends <backups@yourdomain.com>"
CRON_SECRET="your-cron-secret"
