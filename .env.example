# Database. Named URLs for switching; the app reads DATABASE_URL only.
# DATABASE_URL_LOCAL="postgresql://kame_lends:kame_lends@127.0.0.1:5433/kame_lends"                                             
# DATABASE_URL_PROD="postgresql://neondb_owner:...@ep-....ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
#   DATABASE_URL_VERCEL="postgresql://...@ep-....us-east-1.aws.neon.tech/neondb?sslmode=require"
#   Must match Vercel Production DATABASE_URL and GitHub Actions environment secret DATABASE_URL.
# DATABASE_URL="postgresql://..."

# Auth.js
AUTH_SECRET="your-generated-secret-here"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# E2E only (local / preview). Never set on production Vercel.
# E2E_AUTH_SECRET="e2e-local-secret"
# E2E_USER_EMAIL="you@example.com"

# Google Calendar API
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Public (SvelteKit PUBLIC_ prefix)
PUBLIC_APP_URL="https://pawn-tracker.vercel.app"
# Local dev (fixed port :3200): PUBLIC_APP_URL="http://localhost:3200"
PUBLIC_CONTRACT_DISPUTE_VENUE="Pampanga, Philippines"

# Telegram group notifications (optional).
# Shared default bot: set all three for startgroup link + webhook. Groups can also use their own bot token + chat ID in Settings.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME="your_bot_name"
# TELEGRAM_WEBHOOK_SECRET="random-secret-for-x-telegram-bot-api-secret-token"

# AI (optional). Receipt scanning reads uploaded transfer receipts and proposes
# transactions (amount, date, lender) for loan, fund transfer and received payment forms.
# Without keys the scan button is hidden and receipts upload as plain images.
# Production: use a PAID-tier Gemini key. Free-tier data may be used by Google, and
# receipts contain names and account numbers. See docs/architecture/ai-platform.md.
# Comma-separate several keys to rotate across quota limits:
GEMINI_API_KEYS="key1,key2"
# Or a single key:
# GEMINI_API_KEY="your-gemini-api-key"
# Optional fallback when every Gemini key fails (JPEG/PNG/WebP only):
GROQ_API_KEY="your-groq-api-key"
# Kill switch (default on when a key is set) and per-feature disable list:
# AI_ENABLED="false"
# AI_DISABLED_FEATURES="receipt_extraction"
# Model calls per user per rolling 24h (0 = unlimited, default 300):
# AI_DAILY_CALLS_PER_USER="300"
# Skip the 30-day per-user response cache (same image → same answer, no cost):
# AI_RESPONSE_CACHE_DISABLED="1"

# Cloudflare R2 object storage (optional — without these, images stay as data URLs in Postgres)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="kame-lends"
# R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# PUBLIC_R2_ENABLED="true"

# Backup + transactional email (optional)
# RESEND_API_KEY powers signing requests, activity emails, and the daily reminder digest
# for investors, borrowers, and witnesses. Missing key means every notification path skips.
RESEND_API_KEY="re_xxxxxxxxxx"
BACKUP_EMAIL="your-email@example.com"
RESEND_FROM_EMAIL="Kame Lends <noreply@yourdomain.com>"
# Stops notification email only. Backup, money-health, and neon-usage crons still send.
# EMAIL_NOTIFICATIONS_DISABLED="true"
CRON_SECRET="your-cron-secret"

# Neon usage alert (optional weekly cron /api/cron/neon-usage)
# Create an API key in Neon Console → Account settings → API keys.
# NEON_API_KEY=""
# NEON_PROJECT_ID=""
# Alert when billing-period data_transfer_bytes exceeds this (default 10 GiB):
# NEON_TRANSFER_ALERT_BYTES="10737418240"

# Web Push (optional — device notifications for due dates, activity, signing)
# Generate with: bun run pwa:generate-vapid-keys
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
# PUBLIC_VAPID_PUBLIC_KEY=""

# PWA kill-switch (optional)
# PWA_DISABLED="true"
# PWA_MIN_VERSION=""

# Performance logging (optional)
# Requests slower than this many milliseconds write one structured log line.
# SLOW_REQUEST_LOG_MS="500"
